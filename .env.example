PORT=3100

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_NUMBER=+15551234567

# Required for browser calling with Twilio Voice SDK.
# Create these in Twilio Console: Account > API keys and tokens.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret

# Required for browser calling.
# Configure this TwiML App Voice Request URL to:
# https://your-public-url.example.com/voice
# Must be the TwiML App SID that starts with AP, not your Account SID that starts with AC.
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional defaults shown in the web UI.
DEFAULT_MY_PHONE_NUMBER=+15557654321
DEFAULT_FRIEND_PHONE_NUMBER=+15559876543
